# Copy to .env.local for local dev. In Vercel, set these under
# Project Settings -> Environment Variables for the relevant environment
# (Production/Preview/Development) — a var only in .env.example does
# nothing in a deployed environment.

# --- Public (exposed to the browser bundle — no secrets here) ---
NEXT_PUBLIC_ARBOR_RPC_URL=
NEXT_PUBLIC_CANOPY_RPC_URL=
NEXT_PUBLIC_CANOPY_ADMIN_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_DEFAULT_FEE=
NEXT_PUBLIC_STATE_REFRESH_INTERVAL_MS=
NEXT_PUBLIC_TX_POLL_INTERVAL_MS=
NEXT_PUBLIC_TX_TIMEOUT_MS=

# --- Server-only ---
# Base URL this deployment is reachable at (used to build OAuth redirect_uri values
# for Discord/X — must exactly match what's registered in each provider's dev portal,
# including scheme and trailing-slash behavior).
APP_URL=

QUEST_PLUGIN_URL=

# Discord OAuth (Discord Developer Portal -> your app -> OAuth2).
# Redirect URI to register there: ${APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# X (Twitter) OAuth 2.0 (X Developer Portal -> your app -> User authentication settings,
# OAuth 2.0, "Confidential client"). If either of these is unset, /api/auth/twitter/start
# now fails fast with ?error=twitter_not_configured instead of redirecting to X with an
# empty client_id.
# Redirect URI to register there: ${APP_URL}/api/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
