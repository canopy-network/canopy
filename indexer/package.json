{
  "name": "arbor-quest-indexer",
  "version": "0.1.0",
  "description": "Standalone quest/XP indexer for Arbor. Reads Arbor's public RPC only — no changes to the Arbor plugin or its audited state range.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/indexer.ts",
    "bot": "tsx watch src/bot/discordBot.ts",
    "build": "tsc",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "viem": "^2.21.0",
    "express": "^4.19.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0"
  }
}
